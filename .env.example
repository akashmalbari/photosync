# Run `npm run setup` to create your personal .env file.
PHOTO_LIBRARY_PATH="/Users/your-name/Pictures/Photo Library"
# Optional additional sources. The setup assistant supports up to three.
PHOTO_LIBRARY_PATH_2="/Volumes/Family Photos"
PHOTO_LIBRARY_PATH_3="/Volumes/Photo Archive"
# Optional display names; folder names are used when these are omitted.
# PHOTO_LIBRARY_NAME=Main Library
# PHOTO_LIBRARY_NAME_2=Family Photos
# PHOTO_LIBRARY_NAME_3=Archive
PORT=4173
HOST=0.0.0.0
# Optional: protect the library with a shared password.
# LIBRARY_PASSWORD=choose-a-strong-password
